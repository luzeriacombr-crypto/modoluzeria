    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Salvar na Biblioteca de Referências"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://grmayzeeemilvhjeninh.supabase.co/*"]
}
