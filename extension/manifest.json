{
  "manifest_version": 3,
  "name": "Modo Criador — Salvar referência",
  "version": "1.0.0",
  "description": "Salva a página que você está vendo na Biblioteca de Referências do Modo Criador, geral ou em um cliente.",
  "default_locale": "pt_BR",
  "icons": {
    "16": "icons/icon-16.png",
